# ============================================================
# Supabase — اختر سحابة أو محلي، ثم انسخ الملف إلى .env.local
# ============================================================

# --- سحابة (supabase.com > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# --- محلي (يحتاج Docker Desktop ثم: npx supabase start) ---
# انسخ API URL و anon key من مخرجات الأمر، مثال:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-from-cli>

# رقم واتساب المحل (بصيغة دولية بدون + أو أصفار بادئة) مثال: 962790000000
NEXT_PUBLIC_WHATSAPP_NUMBER=962790000000

# رمز العملة المعروض بجانب الأسعار (الشيكل ₪)
NEXT_PUBLIC_CURRENCY=₪
